# Copy this file to .env, then fill in the values. See docs/SELF_HOSTING.md.

# Database superuser password (also used by the Supabase services).
POSTGRES_PASSWORD=change-me-to-a-strong-password

# JWT secret (>= 40 chars). ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with it.
# Generate all three with the Supabase self-hosting key generator (see the guide).
JWT_SECRET=replace-with-a-long-random-secret-at-least-40-chars
ANON_KEY=replace-with-the-anon-jwt
SERVICE_ROLE_KEY=replace-with-the-service-role-jwt

# Realtime needs its own long random base secret (>= 64 chars).
SECRET_KEY_BASE=replace-with-a-64-char-random-string

# URLs. API_EXTERNAL_URL is the Supabase gateway as reachable FROM THE BROWSER;
# it is baked into the front end at build time. SITE_URL is the front end itself.
# For LAN play, replace localhost with the host machine IP (e.g. http://192.168.1.20:8000).
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
